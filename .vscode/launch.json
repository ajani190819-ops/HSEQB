{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome (HSE app)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080/apps/hse/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome (template app)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080/apps/template/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open HSE index.html",
            "file": "${workspaceFolder}/apps/hse/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open template index.html",
            "file": "${workspaceFolder}/apps/template/index.html"
        }
    ]
}
