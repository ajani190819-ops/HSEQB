{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "globalPlayers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "globalSettings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "adminUids": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true",
        ".validate": "newData.val() === true"
      }
    },
    "adminList": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true"
    },

    "appVersion": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true"
    },
    "releaseHtml": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true"
    },
    "releaseHistory": {
      ".read": "auth != null",
      "$releaseId": {
        ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['label', 'buildId', 'title', 'releaseNotes', 'publishedAt', 'publishedByUid']) && newData.child('publishedByUid').val() === auth.uid"
      }
    },

    "userIdentities": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
